{
  "name": "bicho-pr-reviewer",
  "version": "0.0.0",
  "description": "Automated GitHub Pull Request review agent.",
  "license": "MIT",
  "author": "Pablo Jacobi",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node --watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.5.5",
    "fastify": "^5.10.0",
    "jose": "^6.2.4",
    "oxc-parser": "^0.141.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.9.0",
    "msw": "^2.15.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
